{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "TradingViewData": "live-tradingview-ohlc-topic",
      "HealthCheck": "health-check-topic"
    },
    "RetrySettings": {
      "MaxRetries": 3,
      "RetryIntervalMs": 1000
    }
  },
  "TimeZone": "India Standard Time",
  "Features": {
    "DataIngestion": true
  },
  "RateLimits": {
    "MaxRequestsPerMinute": 15,
    "MaxConcurrentRequests": 5
  },
  "Monitoring": {
    "MetricsEnabled": true,
    "LogLevel": "Information"
  },
  "HealthChecks": {
    "Enabled": true,
    "IntervalSeconds": 30
  }
}
